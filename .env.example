# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgres://hermieos:hermieos@localhost:5432/hermieos

# --- Service ports ---
API_PORT=3001
MCP_PORT=3002
WEB_PORT=5173

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=development

# --- Auth ---
SESSION_COOKIE_NAME=hermieos_session
SESSION_TTL_DAYS=30

# --- Cache ---
CACHE_TTL_MS=120000

# --- Scheduler ---
SCHEDULER_TICK_MS=60000
SCHEDULER_RUN_DEADLINE_MS=300000

# --- Hermes (live) ---
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me-local-dev
HERMES_CB_URL=
HERMES_PROFILE=

# --- MCP server (this service, when serving Hermes) ---
# The public URL Hermes should use to reach our MCP server.
MCP_PUBLIC_URL=http://127.0.0.1:3002
