# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgres://hermieos:hermieos@localhost:5432/hermieos

# --- Service ports ---
API_PORT=3001
MCP_PORT=3002
WEB_PORT=5173

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=development

# --- Auth ---
SESSION_COOKIE_NAME=hermieos_session
SESSION_TTL_DAYS=30

# --- Cache ---
CACHE_TTL_MS=120000

# --- Scheduler ---
SCHEDULER_TICK_MS=60000
SCHEDULER_RUN_DEADLINE_MS=300000
RUN_TRACKER_POLL_MS=5000

# --- Hermes (live) ---
# Where the scheduler POSTs /v1/runs. For local dev with the fake
# Hermes container, this is http://fake-hermes:4100. With the real
# profile, this becomes http://hermes:8642.
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me-local-dev

# --- MCP server (this service, when serving Hermes) ---
# The URL Hermes should use to reach our MCP server.
#
# Two modes:
#   HERMIEOS_MCP_MODE=host  (default)
#     MCP runs as a process on this host, port MCP_PORT.
#     hermes-profile-gen writes the URL Hermes will use to reach it as
#     http://host.docker.internal:3002/mcp — Hermes is in a container
#     and reaches the host through Docker's host-gateway alias.
#   HERMIEOS_MCP_MODE=docker
#     MCP runs in its own container on the same Docker network as
#     Hermes (named `hermieos_default` by docker-compose, or whatever
#     network you connected Hermes to). hermes-profile-gen writes
#     http://hermieos-mcp:3002/mcp so Hermes can resolve it by
#     container name. This avoids relying on host.docker.internal.
HERMIEOS_MCP_MODE=host
MCP_PUBLIC_URL=http://127.0.0.1:3002/mcp

# --- Hermes profile generator (only used by the 'real' profile) ---
# The email of the HermieOS user this profile belongs to. The
# generator reads their mcp_token from the DB and writes
# profiles/<HERMES_PROFILE_NAME>/config.yaml.
HERMES_USER_EMAIL=
HERMES_PROFILE_NAME=default

# API server settings written into the profile's .env.
HERMES_API_PORT=8642
HERMES_API_HOST=0.0.0.0
# Where Hermes (in its container) should reach the HermieOS MCP server.
# Defaults are derived from HERMIEOS_MCP_MODE; override only if you have
# a custom network or proxy setup. Inside the docker-compose network the
# MCP service name is `mcp`; the standalone container is `hermieos-mcp`.
HERMES_MCP_URL=
HERMES_MCP_CONTAINER_NAME=hermieos-mcp

# Inference settings. When HERMES_INFERENCE_PROVIDER=custom, both
# HERMES_INFERENCE_BASE_URL and HERMES_INFERENCE_API_KEY are required.
# When 'auto' or 'portal', Hermes uses the Nous Portal — no further
# config needed but the user must have run `hermes setup --portal`
# inside the container at least once.
HERMES_MODEL=hermes-agent
HERMES_INFERENCE_PROVIDER=auto
HERMES_INFERENCE_BASE_URL=
HERMES_INFERENCE_API_KEY=

# Set HERMES_DASHBOARD=1 to enable the built-in web dashboard.
HERMES_DASHBOARD=1
