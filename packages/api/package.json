{
  "name": "@hermieos/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "DATABASE_URL=${DATABASE_URL:-postgres://hermieos:hermieos@localhost:5432/hermieos} SSE_POLL_MS=${SSE_POLL_MS:-300} vitest --no-file-parallelism --sequence.concurrent=false",
    "test:run": "DATABASE_URL=${DATABASE_URL:-postgres://hermieos:hermieos@localhost:5432/hermieos} SSE_POLL_MS=${SSE_POLL_MS:-300} vitest run --no-file-parallelism --sequence.concurrent=false",
    "e2e": "DATABASE_URL=${DATABASE_URL:-postgres://hermieos:hermieos@localhost:5432/hermieos} tsx scripts/phase3-e2e.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/sse": "^0.5.0",
    "@fastify/static": "^10.1.0",
    "@hermieos/cache": "workspace:*",
    "@hermieos/db": "workspace:*",
    "@hermieos/domain": "workspace:*",
    "@hermieos/gateway": "workspace:*",
    "@hermieos/mcp": "workspace:*",
    "argon2": "^0.45.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
