{
  "name": "@hermieos/web",
  "version": "0.0.1",
  "private": true,
  "description": "HermieOS desktop client",
  "author": {
    "name": "HermieOS",
    "email": "dev@hermieos.app"
  },
  "homepage": "https://hermieos.app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "concurrently -k \"pnpm dev\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "electron:build": "pnpm build && electron-builder --linux deb AppImage"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.hermieos.app",
    "productName": "HermieOS",
    "executableName": "hermieos",
    "npmRebuild": false,
    "directories": {
      "output": "electron-dist"
    },
    "artifactName": "${productName}-${version}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "maintainer": "dev@hermieos.app",
      "category": "Productivity",
      "icon": "public/icon-192.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^2.1.8",
    "wait-on": "^9.1.0"
  },
  "optionalDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
